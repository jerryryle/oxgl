{
  "name": "oxgl",
  "version": "0.0.0",
  "private": true,
  "description": "Standards-compliant headless WebGL 1 and WebGL 2 for Node.js",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "napi": {
    "binaryName": "oxgl",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "openspec": "openspec",
    "build": "npm run build:native && npm run build:ts",
    "build:native": "napi build --platform --release --manifest-path crates/oxgl-node/Cargo.toml --output-dir dist --js native.cjs --dts native.d.cts && node scripts/stage-angle.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "lint": "npm run lint:rust && npm run lint:js && npm run lint:licenses",
    "lint:rust": "cargo fmt --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint:js": "eslint . && tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint:licenses": "cargo deny check licenses && node scripts/notices.mjs --check",
    "notices": "node scripts/notices.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@napi-rs/cli": "3.10.9",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
